{
  "name": "novnc-cef-client",
  "version": "1.0.0",
  "description": "基于Electron的NoVNC多窗口群控客户端",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never --config.compression=store"
  },
  "build": {
    "appId": "com.hogan.novncclient",
    "productName": "NoVNC Client",
    "asar": false,
    "files": [
      "**/*",
      "!*.md",
      "!配置文件.int"
    ],
    "extraResources": [
      "配置文件.int"
    ],
    "extraFiles": [
      "配置文件.int"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "keywords": [],
  "author": "Hogan Hong",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2"
  }
}
