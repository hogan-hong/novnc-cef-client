{
  "name": "novnc-cef-client",
  "version": "1.0.0",
  "description": "CEF-based NoVNC client with auto-connect and GPU acceleration",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run build:native || echo 'native模块编译失败，继续打包' && electron-builder --win --publish never",
    "build:native": "node-gyp rebuild || true",
    "rebuild": "npm run build:native"
  },
  "build": {
    "appId": "com.hogan.novncclient",
    "productName": "NoVNC Client",
    "asar": true,
    "asarUnpack": [
      "build/**"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  },
  "keywords": [],
  "author": "Hogan Hong",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "node-gyp": "^11.0.0"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2"
  }
}
