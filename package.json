{
  "name": "novnc-cef-client",
  "version": "1.0.0",
  "description": "CEF-based NoVNC client with auto-connect and GPU acceleration",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build:win": "node scripts/build-win.js",
    "build:native": "node-gyp rebuild",
    "rebuild": "npm run build:native"
  },
  "build": {
    "appId": "com.hogan.novncclient",
    "productName": "NoVNC Client",
    "asar": true,
    "asarUnpack": [
      "build/**"
    ],
    "files": [
      "**/*",
      "!*.md",
      "!binding.gyp",
      "!配置文件.int"
    ],
    "extraResources": [
      "配置文件.int"
    ],
    "extraFiles": [
      "配置文件.int"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "keywords": [],
  "author": "Hogan Hong",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "node-gyp": "^11.0.0"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2"
  }
}
